{
  "$id": "https://psmatrix.dev/schemas/windows-authoritative-matrix-predicate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "not": {
          "required": [
            "release_binding"
          ]
        }
      },
      "if": {
        "properties": {
          "schema": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "release_binding"
        ]
      }
    }
  ],
  "properties": {
    "authoritative": {
      "const": true
    },
    "campaigns": {
      "items": {
        "properties": {
          "campaign_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "image_manifest_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "run_count": {
            "minimum": 2,
            "type": "integer"
          },
          "valid": {
            "const": true
          }
        },
        "required": [
          "runtime_id",
          "valid",
          "run_count",
          "campaign_sha256",
          "image_manifest_sha256"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "created_at": {
      "minLength": 1,
      "type": "string"
    },
    "matrix_id": {
      "type": "string"
    },
    "release_binding": {
      "$ref": "windows-release-binding.schema.json"
    },
    "required_runtimes": {
      "items": {
        "enum": [
          "windows-powershell-4.0",
          "windows-powershell-5.0",
          "windows-powershell-5.1"
        ]
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "enum": [
        1,
        2
      ]
    }
  },
  "required": [
    "schema",
    "matrix_id",
    "created_at",
    "required_runtimes",
    "campaigns",
    "authoritative"
  ],
  "type": "object"
}
