{
  "schema": 1,
  "kind": "psmatrix.windows-authority-operation-package-binding-contract",
  "pack": "03-authoritative-windows",
  "canonical_inventory_kind": "psmatrix.windows-authority-media-inventory",
  "operation_package_kind": "psmatrix.windows-authoritative-operation-package",
  "rules": {
    "canonical_release_authority_must_be_ready": true,
    "operation_package_release_manifest_sha256_must_match_canonical_manifest": true,
    "operation_zip_sha256_must_match_package_metadata": true,
    "operation_zip_size_must_match_package_metadata": true,
    "release_binding_must_be_valid": true,
    "stale_binding_blocks_artifact_recovery": true,
    "zip_entry_inventory_is_read_only": true
  },
  "release_artifact_suffixes": [
    "-source.zip",
    "-windows-workers.zip",
    "-windows-certification-kit.zip",
    "-windows-provisioning-kit.zip",
    "-release.json"
  ],
  "safety": {
    "downloads_files": false,
    "extracts_archives": false,
    "writes_release_artifacts": false,
    "opens_secret_bundles": false,
    "creates_virtual_machines": false,
    "creates_checkpoints": false,
    "writes_validator_input_files": false,
    "authoritative": false,
    "ga_eligible": false
  }
}
