  "kind": "psmatrix.windows-authoritative-fixture-pack",
  "entrypoint": "authoritative-capabilities.ps1",
  "options_template": "authoritative-options.json",
  "supported_runtimes": [
    "windows-powershell-4.0",
    "windows-powershell-5.0",
    "windows-powershell-5.1"
