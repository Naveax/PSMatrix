{
  "$id": "https://psmatrix.dev/schemas/full-matrix.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "differential": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "baseline_runtime": {
                "type": "string"
              },
              "candidate_runtime": {
                "type": "string"
              },
              "dimension": {
                "type": "string"
              },
              "reason": {
                "maxLength": 2048,
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "dimension"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "type": "array"
        },
        "allowance_file": {
          "type": "string"
        },
        "baseline_runtime": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "off",
            "report",
            "strict"
          ]
        }
      },
      "type": "object"
    },
    "kind": {
      "const": "psmatrix.full-matrix-spec"
    },
    "name": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "requirements": {
      "additionalProperties": false,
      "properties": {
        "require_complete": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "schema": {
      "const": 1
    },
    "targets": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "arch": {
                "enum": [
                  "x64",
                  "arm64",
                  "arm32"
                ]
              },
              "args": {
                "items": {
                  "type": "string"
                },
                "maxItems": 128,
                "type": "array"
              },
              "backend": {
                "enum": [
                  "auto",
                  "native",
                  "oci"
                ]
              },
              "container_engine": {
                "enum": [
                  "auto",
                  "docker",
                  "podman"
                ]
              },
              "id": {
                "type": "string"
              },
              "kind": {
                "const": "local"
              },
              "libc": {
                "enum": [
                  "glibc",
                  "musl"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "version"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "args": {
                "items": {
                  "type": "string"
                },
                "maxItems": 128,
                "type": "array"
              },
              "endpoint": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "kind": {
                "const": "remote"
              },
              "options": {
                "type": "object"
              },
              "required": {
                "type": "boolean"
              },
              "runtime_id": {
                "pattern": "^(?:windows-powershell-(?:4\\.0|5\\.0|5\\.1)|powershell-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?-windows-(?:x64|x86|arm64))$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "runtime_id",
              "endpoint"
            ],
            "type": "object"
          }
        ]
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "kind",
    "name",
    "targets"
  ],
  "title": "PSMatrix complete mixed-platform matrix specification",
  "type": "object"
}
