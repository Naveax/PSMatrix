{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psmatrix.dev/schemas/windows-lab-media.schema.json",
  "title": "PSMatrix Windows lab media manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "hyperv_host", "defaults", "images"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "psmatrix.windows-lab-media"},
    "hyperv_host": {
      "type": "object", "additionalProperties": false,
      "required": ["host_id", "lab_root"],
      "properties": {"host_id": {"type": "string"}, "lab_root": {"type": "string"}}
    },
    "defaults": {
      "type": "object", "additionalProperties": false,
      "required": ["switch_name", "checkpoint_name"],
      "properties": {"switch_name": {"type": "string"}, "checkpoint_name": {"type": "string"}}
    },
    "images": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["runtime_id", "image_id", "worker_id", "computer_name", "output_vhdx", "source_iso", "edition_index", "worker_package", "python_installer", "credential_bundle", "signing_bundle", "expected_os", "admin_password_env"],
        "properties": {
          "runtime_id": {"enum": ["windows-powershell-4.0", "windows-powershell-5.0", "windows-powershell-5.1"]},
          "image_id": {"type": "string"}, "worker_id": {"type": "string"}, "computer_name": {"type": "string"},
          "architecture": {"const": "x64"}, "generation": {"enum": [1, 2]},
          "processors": {"type": "integer", "minimum": 1, "maximum": 64},
          "memory_mb": {"type": "integer", "minimum": 1024, "maximum": 262144},
          "switch_name": {"type": "string"}, "output_vhdx": {"type": "string"}, "edition_index": {"type": "integer", "minimum": 1},
          "source_iso": {"$ref": "#/$defs/artifact"}, "wmf_package": {"$ref": "#/$defs/artifact"},
          "worker_package": {"$ref": "#/$defs/artifact"}, "python_installer": {"$ref": "#/$defs/artifact"},
          "credential_bundle": {"$ref": "#/$defs/artifact"}, "signing_bundle": {"$ref": "#/$defs/artifact"},
          "expected_os": {
            "type": "object", "additionalProperties": {"type": "string"},
            "required": ["product_name", "version", "build"]
          },
          "admin_password_env": {"type": "string", "pattern": "^PSMATRIX_[A-Z0-9_]+$"},
          "worker_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
          "checkpoint_name": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "size": {"type": "integer", "minimum": 1}}
    }
  }
}
