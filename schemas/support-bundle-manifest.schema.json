{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psmatrix.dev/schemas/support-bundle-manifest.schema.json",
  "title": "PSMatrix redacted support bundle manifest",
  "type": "object",
  "required": ["schema", "kind", "version", "files", "redaction"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "psmatrix.support-bundle"},
    "version": {"type": "string"},
    "created_at": {"type": ["string", "null"]},
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "size"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "redaction": {"type": "object"}
  },
  "additionalProperties": false
}
