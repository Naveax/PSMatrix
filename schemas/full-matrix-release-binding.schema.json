{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psmatrix.dev/schemas/full-matrix-release-binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "release_version", "release_commit", "release_manifest_sha256", "source", "wheel", "canonical_target_count", "canonical_targets_sha256", "release_key_ids", "binding_sha256"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "psmatrix.full-matrix-release-binding"},
    "release_version": {"pattern": "^2\\.0\\.0(?:rc[0-9]+)?$", "type": "string"},
    "release_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "release_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "source": {"$ref": "#/$defs/artifact"},
    "wheel": {"$ref": "#/$defs/artifact"},
    "canonical_target_count": {"const": 25},
    "canonical_targets_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "release_key_ids": {"type": "array", "minItems": 1, "items": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}},
    "binding_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256", "size"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "size": {"type": "integer", "minimum": 1}
      }
    }
  }
}
