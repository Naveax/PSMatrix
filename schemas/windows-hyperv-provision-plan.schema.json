{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psmatrix.dev/schemas/windows-hyperv-provision-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "host_id", "lab_root", "source_manifest", "images", "safety", "plan_sha256"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "psmatrix.windows-hyperv-provision-plan"},
    "created_at": {"type": "string"},
    "host_id": {"type": "string"},
    "lab_root": {"type": "string"},
    "source_manifest": {"type": "object"},
    "images": {"type": "array", "minItems": 3, "maxItems": 3},
    "safety": {"type": "object"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
