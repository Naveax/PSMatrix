{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psmatrix.local/schemas/patch-bundle.schema.json",
  "title": "PSMatrix Patch Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "bundle_id", "created_at", "plan_id", "report_sha256", "validation_argv_sha256", "baseline_targets", "actions", "summary"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "psmatrix.patch-bundle"},
    "bundle_id": {"type": "string", "pattern": "^rpb_[0-9a-f]{24}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "plan_id": {"type": "string", "pattern": "^rpl_[0-9a-f]{24}$"},
    "report_sha256": {"$ref": "#/$defs/sha256"},
    "validation_argv_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_targets": {"type": "array", "maxItems": 32768, "items": {"$ref": "#/$defs/target"}},
    "actions": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/action"}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "edit_bytes", "diagnostic_codes"],
      "properties": {
        "files": {"type": "integer", "minimum": 1, "maximum": 32},
        "edit_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
        "diagnostic_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "runtime_id", "runtime_version", "status"],
      "properties": {
        "path": {"type": "string"}, "runtime_id": {"type": "string"},
        "runtime_version": {"type": "string"}, "status": {"type": "string"}
      }
    },
    "edit": {
      "type": "object", "additionalProperties": false,
      "required": ["old", "new", "occurrence", "diagnostic_codes", "reason"],
      "properties": {
        "old": {"type": "string", "minLength": 1},
        "new": {"type": "string"},
        "occurrence": {"type": "integer", "minimum": 1},
        "diagnostic_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "reason": {"type": "string"}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "before_sha256", "after_sha256", "mode", "edits", "unified_diff"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"type": "integer", "minimum": 0, "maximum": 4095},
        "edits": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/edit"}},
        "unified_diff": {"type": "string"}
      }
    }
  }
}
